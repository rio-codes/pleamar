language 0.4
// Keyboard or state feedback, without a simulated mouse press.
// pleamar --say glass-feedback "emit select 2"
scene GlassFeedback {
    surface { size: 420, 120; kind: window; title: "Glass feedback"; keyboard: on_demand }
    fact selected = 0
    event select
    on select(n) { selected = n }
    on key Right { selected = mod(selected + 1, 3) }
    on key Left { selected = mod(selected + 2, 3) }

    body {
        color: #24332d; glass: 100%; shine: pointer
        box { from: 0, 0; size: 420, 120; corner: 20 }
    }
    row { at: 30, 20; gap: 12
        repeat i in 0..3 {
            group { size: 112, 48
                box hit { from: 0, 0; size: 112, 48; corner: 12; color: if(selected == i, #9ed6bd, #42534b); cursor: pointer; label: "Tab {i + 1}" }
                text "{i + 1}" { at: 56, 24; anchor: center; size: 18; color: #14231b }
                on press hit { selected = i }
                on change selected while selected == i { ripple hit }
            }
        }
    }
    text "Left / Right, or click a tab" { at: 210, 92; anchor: center; size: 14; color: #e8efe9 }
}
